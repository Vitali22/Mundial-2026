PORT=3001

# mock: usa datos de ejemplo locales.
# api-football: usa la API externa API-FOOTBALL.
DATA_PROVIDER=mock

# Solo necesario si DATA_PROVIDER=api-football.
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Ajusta estos valores segun la competicion real que uses en tu API.
# En API-FOOTBALL, la Copa Mundial suele usar league=1.
WORLD_CUP_LEAGUE_ID=1
WORLD_CUP_SEASON=2026

# Duracion estimada del partido y espera posterior antes de consultar de nuevo.
MATCH_DURATION_MINUTES=120
REFRESH_GRACE_MINUTES=30
